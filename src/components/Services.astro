---
import { CONTACT } from '../config/contact';

interface ServiceItem {
  id: string;
  title: string;
  benefits: string[];
  price: string;
  duration: string;
  exampleProjectId?: string;
}

interface Props {
  services: any;
  lang: 'vi' | 'en';
  // Projects that have a /projects/<id>/ page; an example link is shown only for these
  projectIdsWithDetail: string[];
}

const { services: s, lang, projectIdsWithDetail } = Astro.props;
const items: ServiceItem[] = s.items || [];
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<article class="services" data-lang={lang}>
  <section class="svc-hero">
    <h1>{s.hero.title}</h1>
    <p class="svc-subtitle">{s.hero.subtitle}</p>
    <div class="svc-actions">
      <a class="svc-btn svc-btn--primary svc-zalo" href={CONTACT.zaloHref} {...external}>{s.hero.primaryCta}</a>
      <a class="svc-btn svc-btn--ghost svc-projects" href={`/?lang=${lang}#du-an`}>{s.hero.secondaryCta}</a>
    </div>
  </section>

  <section class="svc-list">
    {items.map((item) => (
      <article class="svc-card" data-service-id={item.id}>
        <h2>{item.title}</h2>
        <p class="svc-label">{s.labels.benefits}</p>
        <ul class="svc-benefits">
          {item.benefits.map((b) => <li>{b}</li>)}
        </ul>
        <div class="svc-meta">
          <span class="svc-price">{item.price}</span>
          <span class="svc-duration">{s.labels.duration}: {item.duration}</span>
        </div>
        {item.exampleProjectId && projectIdsWithDetail.includes(item.exampleProjectId) && (
          <a class="svc-example" href={`/projects/${item.exampleProjectId}/`}>{s.labels.example} →</a>
        )}
      </article>
    ))}
  </section>

  <section class="svc-process">
    <h2>{s.process.title}</h2>
    <ol>
      {s.process.steps.map((step: { title: string; text: string }) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="svc-why">
    <h2>{s.whyMe.title}</h2>
    <ul>
      {s.whyMe.points.map((p: string) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="svc-faq">
    <h2>{s.faq.title}</h2>
    {s.faq.items.map((f: { q: string; a: string }) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="svc-cta">
    <h2>{s.cta.title}</h2>
    <p>{s.cta.text}</p>
    <div class="svc-actions">
      <a class="svc-btn svc-btn--primary svc-zalo" href={CONTACT.zaloHref} {...external}>{s.cta.zalo}</a>
      <a class="svc-btn svc-btn--ghost svc-phone" href={CONTACT.phoneHref}>{s.cta.phone} · {CONTACT.phone}</a>
    </div>
  </section>
</article>

<style>
  .services {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    overflow-wrap: anywhere;
  }

  h2 {
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    margin: 0 0 1rem;
  }

  h3 {
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  p,
  li {
    color: var(--muted);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .svc-subtitle {
    font-size: 1.1rem;
    max-width: 46rem;
    margin: 0 0 1.5rem;
  }

  .svc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .svc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }

  .svc-btn--primary {
    background: var(--accent);
    color: #ffffff;
  }

  .svc-btn--primary:hover {
    background: #0284c7;
  }

  .svc-btn--ghost {
    background: var(--surface-weak);
    color: var(--text);
  }

  .svc-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    .svc-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-weak);
  }

  .svc-card h2 {
    font-size: 1.25rem;
    margin: 0;
  }

  .svc-label {
    margin: 0.25rem 0 0;
    font-weight: 700;
    color: var(--text);
  }

  .svc-benefits {
    margin: 0;
    padding-left: 1.2rem;
    flex: 1;
  }

  .svc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .svc-price {
    font-size: 1.35rem;
    font-weight: 800;
    color: #075985;
  }

  .svc-duration {
    color: var(--muted);
    font-weight: 600;
  }

  .svc-example {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .svc-process ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .svc-process li {
    counter-increment: step;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--surface-softer);
  }

  .svc-process li::before {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.5rem;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.12);
    color: #075985;
    font-weight: 800;
  }

  .svc-process p {
    margin: 0;
  }

  .svc-why ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-why li {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--surface-softer);
    color: var(--text);
    font-weight: 600;
  }

  .svc-faq details {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(2, 6, 23, 0.08);
  }

  .svc-faq summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
  }

  .svc-faq details p {
    margin: 0.5rem 0 0;
  }

  .svc-cta {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: rgba(14, 165, 233, 0.08);
    text-align: center;
  }

  .svc-cta p {
    margin: 0 0 1.25rem;
  }

  .svc-cta .svc-actions {
    justify-content: center;
  }
</style>
