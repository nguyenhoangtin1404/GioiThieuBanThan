---
import { CONTACT } from '../config/contact';
import ServicesFeatured from './ServicesFeatured.astro';
import { resolveFeatured } from './servicesFeatured';

interface ServiceItem {
  id: string;
  title: string;
  benefits: string[];
  price: string;
  duration: string;
  exampleProjectId?: string;
  fit?: string;
  featured?: boolean;
}

interface Props {
  services: any;
  lang: 'vi' | 'en';
  // Projects that have a /projects/<id>/ page; an example link is shown only for these
  projectIdsWithDetail: string[];
  // projects.items in the same language, for featured work
  projects: any[];
}

const { services: s, lang, projectIdsWithDetail, projects } = Astro.props;
const items: ServiceItem[] = s.items || [];
const external = { target: '_blank', rel: 'noopener noreferrer' };
const featured = resolveFeatured(s.featured || [], projects, projectIdsWithDetail);
const serviceTitles = Object.fromEntries(items.map((i) => [i.id, i.title]));

// Stroke icons in the style of the home Contact glyphs, one per service
const GLYPHS: Record<string, string> = {
  website: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  management: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 17.5h7M17.5 14v7"/>',
  automation: '<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9.5 17h5"/>'
};
const CHECK = '<path d="m5 12.5 4.5 4.5L19 7.5"/>';
---

<article class="services" data-lang={lang}>
  <a class="svc-back" href={`/?lang=${lang}`}>← {s.labels.back}</a>

  <section class="svc-hero">
    <div class="svc-hero-text">
      <span class="svc-badge">{s.labels.badge}</span>
      <h1>{s.hero.title}</h1>
      <p class="svc-subtitle">{s.hero.subtitle}</p>
      <div class="svc-actions">
        <a class="svc-btn svc-btn--primary svc-zalo" href={CONTACT.zaloHref} {...external}>{s.hero.primaryCta}</a>
        <a class="svc-btn svc-btn--ghost svc-projects" href={`/?lang=${lang}#du-an`}>{s.hero.secondaryCta}</a>
      </div>
      <ul class="svc-trust">
        {(s.trust || []).map((t: { value: string; label: string }) => (
          <li>
            <strong class="svc-trust-value">{t.value}</strong>
            <span class="svc-trust-label">{t.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="svc-hero-media">
      <picture>
        <source type="image/webp" srcset="/contact-360.webp 360w, /contact-720.webp 720w" sizes="(max-width: 767px) 96px, 420px" />
        <img class="svc-photo" src="/contact-768.jpg" width="768" height="768" fetchpriority="high" decoding="async" alt={s.labels.photoAlt} />
      </picture>
    </div>
  </section>

  <section class="svc-list">
    {items.map((item) => (
      <article class={item.featured ? 'svc-card svc-card--popular' : 'svc-card'} data-service-id={item.id}>
        {item.featured && <span class="svc-popular">{s.labels.popular}</span>}
        <span class="svc-glyph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLYPHS[item.id] || GLYPHS.website} />
        </span>
        <h2>{item.title}</h2>
        {item.fit && <p class="svc-fit"><strong>{s.labels.fit}:</strong> {item.fit}</p>}
        <p class="svc-label">{s.labels.benefits}</p>
        <ul class="svc-benefits">
          {item.benefits.map((b) => (
            <li>
              <span class="svc-glyph svc-glyph--sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CHECK} />
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="svc-meta">
          <span class="svc-price">{item.price}</span>
          <span class="svc-duration">{s.labels.duration}: {item.duration}</span>
        </div>
        {item.exampleProjectId && projectIdsWithDetail.includes(item.exampleProjectId) && (
          <a class="svc-example" href={`/projects/${item.exampleProjectId}/`}>{s.labels.example} →</a>
        )}
        <a class="svc-btn svc-btn--ghost svc-ask" href={CONTACT.zaloHref} {...external}>{s.labels.askCard}</a>
      </article>
    ))}
  </section>

  <ServicesFeatured items={featured} title={s.labels.featuredTitle} serviceTitles={serviceTitles} />

  <section class="svc-process">
    <h2 class="svc-title">{s.process.title}</h2>
    <ol>
      {s.process.steps.map((step: { title: string; text: string }) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="svc-why">
    <h2 class="svc-title">{s.whyMe.title}</h2>
    <ul>
      {s.whyMe.points.map((p: string) => (
        <li>
          <span class="svc-glyph svc-glyph--sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CHECK} />
          </span>
          <span>{p}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="svc-faq">
    <h2 class="svc-title">{s.faq.title}</h2>
    {s.faq.items.map((f: { q: string; a: string }) => (
      <details>
        <summary>
          <span>{f.q}</span>
          <svg class="svc-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="svc-cta">
    <h2 class="svc-title">{s.cta.title}</h2>
    <p>{s.cta.text}</p>
    <div class="svc-actions">
      <a class="svc-btn svc-btn--primary svc-zalo" href={CONTACT.zaloHref} {...external}>{s.cta.zalo}</a>
      <a class="svc-btn svc-btn--ghost svc-phone" href={CONTACT.phoneHref}><span>{s.cta.phone} · <span class="svc-phone-number">{CONTACT.phone}</span></span></a>
    </div>
  </section>
</article>

<style>
  .services {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5rem);
  }

  p,
  li {
    color: var(--muted);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  /* Back link: same as the project detail pages */
  .svc-back {
    align-self: flex-start;
    /* 44px tap target; the negative margins keep the layout as if it were 26px tall */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -9px;
    margin-bottom: calc(-1 * clamp(2rem, 5vw, 3.5rem) - 9px);
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }

  .svc-back:hover {
    color: var(--text);
  }

  /* Hero: badge, big title, muted subtitle, pill buttons (home Hero) */
  .svc-badge {
    display: inline-flex;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.15);
    color: #0369a1;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  /* Two columns like the home Hero: text left, the owner's photo right */
  .svc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .svc-hero h1 {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    max-width: 22ch;
    overflow-wrap: anywhere;
  }

  /* Gradient ring, same technique as the home avatar */
  .svc-hero-media {
    justify-self: end;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
    border: 4px solid transparent;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(var(--card), var(--card)) padding-box,
      linear-gradient(135deg, var(--accent), #6366f1) border-box;
    box-sizing: border-box;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  .svc-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .svc-trust li {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .svc-trust-value {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
  }

  .svc-trust-label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .svc-hero {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    /* Small avatar in the badge row, so the first screen reaches the prices */
    .svc-hero {
      position: relative;
    }

    .svc-hero-media {
      position: absolute;
      top: 0;
      right: 0;
      width: 56px;
      height: 56px;
      border-width: 3px;
      border-radius: 50%;
    }

    .svc-badge {
      margin-bottom: 1.25rem;
    }

    .svc-subtitle {
      font-size: 1rem;
      margin-bottom: 1.25rem;
    }

    .svc-hero h1 {
      font-size: clamp(1.6rem, 7vw, 2rem);
    }

    /* One line that scrolls inside itself, never the page; the third stat peeks in
       under a fade so it is clear there is more to swipe */
    .svc-trust {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 1rem;
      margin-top: 0.75rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 80%, transparent);
      mask-image: linear-gradient(90deg, #000 80%, transparent);
    }

    .svc-trust::-webkit-scrollbar {
      display: none;
    }

    .svc-trust li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    .svc-trust li:last-child {
      padding-right: 2rem;
    }

    .svc-trust-value {
      font-size: 1.1rem;
    }

    .svc-trust-label {
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .services {
      gap: 2rem;
    }

    .svc-hero .svc-actions {
      gap: 0.75rem;
    }

  }

  .svc-subtitle {
    font-size: 1.1rem;
    max-width: 46rem;
    margin: 0 0 1.75rem;
  }

  .svc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .svc-btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: transform 150ms ease, filter 150ms ease, background 150ms ease;
  }

  .svc-btn:hover {
    transform: translateY(-2px);
  }

  .svc-btn--primary {
    background: linear-gradient(135deg, var(--accent), #6366f1);
    color: #010409;
  }

  .svc-btn--primary:hover {
    filter: brightness(0.97);
  }

  .svc-btn--ghost {
    background: var(--surface-weak);
    color: var(--text);
  }

  /* Section titles: home size and the short accent bar (Projects, Timeline, Contact) */
  /* :global so the title inside ServicesFeatured gets the same look */
  .services :global(.svc-title) {
    margin: 0 0 1.75rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .services :global(.svc-title)::after {
    content: '';
    display: block;
    width: 56px;
    height: 4px;
    border-radius: 999px;
    background: var(--accent);
    margin-top: 0.5rem;
  }

  /* Round glyph backdrop, as on the home Contact channels */
  .svc-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 50%;
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(14, 165, 233, 0.12);
    box-sizing: border-box;
    color: var(--accent);
  }

  .svc-glyph svg {
    width: 22px;
    height: 22px;
  }

  .svc-glyph--sm {
    width: 32px;
    height: 32px;
    padding: 7px;
  }

  .svc-glyph--sm svg {
    width: 16px;
    height: 16px;
  }

  .svc-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    .svc-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface-weak);
    transition: transform 150ms ease;
  }

  .svc-card:hover {
    transform: translateY(-2px);
  }

  .svc-card h2 {
    font-size: 1.3rem;
    margin: 0.4rem 0 0;
  }

  .svc-label {
    margin: 0.25rem 0 0;
    font-weight: 700;
    color: var(--text);
  }

  .svc-card {
    position: relative;
  }

  .svc-fit {
    margin: 0;
    font-size: 0.95rem;
  }

  .svc-fit strong {
    color: var(--text);
  }

  .svc-benefits {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
  }

  .svc-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .svc-benefits .svc-glyph--sm {
    width: 24px;
    height: 24px;
    padding: 4px;
    margin-top: 0.1rem;
  }

  .svc-benefits .svc-glyph--sm svg {
    width: 14px;
    height: 14px;
  }

  .svc-ask {
    width: 100%;
    margin-top: 0.75rem;
  }

  /* Popular card: gradient border, same padding-box/border-box technique as the photo ring */
  .svc-card--popular {
    border: 2px solid transparent;
    background:
      linear-gradient(#f5f6f8, #f5f6f8) padding-box,
      linear-gradient(135deg, var(--accent), #6366f1) border-box;
  }

  .svc-popular {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #6366f1);
    color: #010409;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .svc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .svc-price {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0369a1;
  }

  .svc-duration {
    color: var(--muted);
    font-weight: 600;
  }

  .svc-example {
    /* 44px tap target; negative margins keep the visual spacing */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -9px;
    color: #0369a1;
    font-weight: 700;
    text-decoration: none;
  }

  .svc-example:hover {
    text-decoration: underline;
  }

  .svc-process ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .svc-process li {
    counter-increment: step;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--surface-weak);
  }

  .svc-process li::before {
    content: counter(step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.6rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #6366f1);
    color: #010409;
    font-weight: 700;
  }

  .svc-process h3 {
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
    color: var(--text);
  }

  .svc-process p {
    margin: 0;
  }

  .svc-why ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-why li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-weak);
    color: var(--text);
    font-weight: 600;
    line-height: 1.5;
  }

  .svc-faq details {
    /* Vertical room comes from the 48px summary row */
    padding: 0.25rem 1.25rem;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--surface-weak);
  }

  /* Accordion row: the whole summary is the target, chevron instead of the native marker */
  .svc-faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
  }

  .svc-faq summary::-webkit-details-marker {
    display: none;
  }

  .svc-chevron {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 200ms ease;
  }

  .svc-faq details[open] .svc-chevron {
    transform: rotate(180deg);
  }

  /* Keyboard focus: one visible ring for every control on the page */
  .services a:focus-visible,
  .services summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .services *,
    .services *::before,
    .services *::after {
      transition: none !important;
    }

    .svc-btn:hover,
    .svc-card:hover {
      transform: none;
    }
  }

  .svc-faq details p {
    margin: 0 0 0.75rem;
  }

  /* Closing call to action: the home Contact card background */
  .svc-cta {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(14, 165, 233, 0.08));
  }

  .svc-phone-number {
    white-space: nowrap;
  }

  /* Same size as the home Contact title, whose card this block copies */
  .svc-cta :global(.svc-title) {
    font-size: clamp(2rem, 4vw, 2.6rem);
  }

  .svc-cta p {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
  }

  /* Mobile card layout; after the base .svc-card rules so it wins */
  @media (max-width: 767px) {
    /* Card: icon beside the title, then the price, then the details */
    .svc-card {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
      column-gap: 0.75rem;
      padding: 1.25rem;
    }

    .svc-card > * {
      grid-column: 1 / -1;
    }

    .svc-card > .svc-glyph {
      grid-column: 1;
    }

    .svc-card > h2 {
      grid-column: 2;
      margin: 0;
    }

    .svc-card > .svc-meta {
      order: 1;
      margin-top: 0.25rem;
    }

    .svc-card > .svc-fit { order: 2; }
    .svc-card > .svc-label { order: 3; }
    .svc-card > .svc-benefits { order: 4; }
    .svc-card > .svc-example { order: 5; }
    .svc-card > .svc-ask { order: 6; }

    /* In the flow on its own row, so it never covers the title */
    .svc-card > .svc-popular {
      position: static;
      order: -1;
      margin-bottom: 0.5rem;
    }
  }
</style>
