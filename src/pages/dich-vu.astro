---
import BaseLayout from '@layouts/BaseLayout.astro';
import Services from '@components/Services.astro';
import { getTranslations, getProjectIds } from '@i18n/utils';
import { CONTACT } from '../config/contact';

// The static build has no query string, so both languages are rendered and
// CSS shows the one matching <html lang> (same pattern as projects/[id].astro).
const LANGS = ['vi', 'en'] as const;
const viServices = (await getTranslations('vi')).services;
const versions = await Promise.all(
  LANGS.map(async (lang) => {
    const t = await getTranslations(lang);
    return {
      lang,
      // A language without `services` falls back to the Vietnamese content
      services: t.services || viServices,
      projects: t.projects?.items || []
    };
  })
);
const projectIdsWithDetail = await getProjectIds();
const vi = versions[0].services;
const titles = Object.fromEntries(versions.map((v) => [v.lang, v.services.meta.title]));
---

<BaseLayout title={vi.meta.title} description={vi.meta.description}>
  <main class="services-page" data-titles={JSON.stringify(titles)}>
    {versions.map((v) => (
      <div data-lang-block={v.lang}>
        <Services services={v.services} lang={v.lang} projectIdsWithDetail={projectIdsWithDetail} projects={v.projects} />
      </div>
    ))}
  </main>

  <!-- Mobile: one-tap contact, fixed at the bottom (hidden on desktop) -->
  <nav class="svc-contact-bar" aria-label={vi.cta.title} data-i18n-attr="aria-label:services.cta.title">
    <a class="svc-bar-zalo" href={CONTACT.zaloHref} target="_blank" rel="noopener noreferrer">Zalo</a>
    <a class="svc-bar-call" href={CONTACT.phoneHref} data-i18n="services.labels.call">{vi.labels.call}</a>
  </nav>

  <script is:inline>
    // The home navigation pill is shown here too (desktop): services is the active item
    // and the section buttons lead back to that section of the home page.
    (function() {
      document.querySelectorAll('#sidebar li').forEach((li) => {
        li.classList.toggle('active', li.classList.contains('sidebar-link'));
      });
      document.querySelector('#sidebar li.sidebar-link a')?.setAttribute('aria-current', 'page');
      document.querySelectorAll('#sidebar li[data-menuanchor] button').forEach((button) => {
        button.addEventListener('click', () => {
          const lang = document.documentElement.lang === 'en' ? 'en' : 'vi';
          const anchor = button.closest('li')?.getAttribute('data-menuanchor');
          window.location.href = `/?lang=${lang}#${anchor}`;
        });
      });
    })();

    // Show the page title for the displayed language
    (function() {
      const main = document.querySelector('.services-page');
      let titles = {};
      try { titles = JSON.parse(main?.getAttribute('data-titles') || '{}'); } catch {}
      const sync = () => {
        const lang = document.documentElement.lang === 'en' ? 'en' : 'vi';
        if (titles[lang]) document.title = titles[lang];
      };
      window.addEventListener('langchange', () => setTimeout(sync, 0));
      sync();
    })();
  </script>

  <style is:global>
    html[lang='en'] [data-lang-block='vi'],
    html:not([lang='en']) [data-lang-block='en'] {
      display: none;
    }

    /* BaseLayout hides the navigation pill on non-fullpage pages; this page keeps it (desktop) */
    @media (min-width: 768px) {
      body:not(:has(#fullpage)):has(.services-page) .sidebar-nav {
        display: flex !important;
      }

      /* Narration exists only on the home page; no dead voice button here */
      body:has(.services-page) .sidebar-nav [data-voice-toggle] {
        display: none !important;
      }
    }
  </style>

  <style>
    .services-page {
      max-width: 1100px;
      margin: 0 auto;
      /* Top room for the fixed navigation pill */
      padding: 6.5rem clamp(1rem, 4vw, 3rem) 5rem;
    }

    .svc-contact-bar {
      display: none;
    }

    @media (max-width: 767px) {
      .services-page {
        /* Room for the contact bar so it never covers the final call to action */
        padding: 1.5rem 1rem calc(64px + 16px + env(safe-area-inset-bottom));
      }

      .svc-contact-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 50;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
        background: #ffffff;
        box-shadow: 0 -6px 20px rgba(2, 6, 23, 0.08);
      }

      .svc-contact-bar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
      }

      .svc-contact-bar a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .svc-bar-zalo {
        background: linear-gradient(135deg, var(--accent), #6366f1);
        color: #010409;
      }

      .svc-bar-call {
        background: var(--surface-weak);
        color: var(--text);
      }
    }
  </style>
</BaseLayout>
